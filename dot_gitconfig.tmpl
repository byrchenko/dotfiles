[user]
	name = {{ .name }}
	email = {{ .email }}
[init]
	defaultBranch = main
[core]
	autocrlf = input
{{- if lookPath "code" }}
	editor = code --wait
{{- end }}
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[rebase]
	autoStash = true
[diff]
	colorMoved = default
[merge]
	conflictstyle = zdiff3
{{- $gcm := "/mnt/c/Program Files/Git/mingw64/bin/git-credential-manager.exe" }}
{{- if stat $gcm }}
[credential]
	# WSL: reuse the Windows Git Credential Manager
	helper = {{ $gcm | replace " " "\\\\ " }}
{{- end }}
[alias]
	st = status -sb
	co = checkout
	sw = switch
	br = branch
	cm = commit -m
	amend = commit --amend --no-edit
	lg = log --graph --oneline --decorate --all
	undo = reset --soft HEAD~1

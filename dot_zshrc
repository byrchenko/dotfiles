# Managed by chezmoi — edit with `chezmoi edit ~/.zshrc`. Machine-only tweaks go in ~/.zshrc.local

export PATH="$HOME/.local/bin:$PATH"

# History
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt SHARE_HISTORY HIST_IGNORE_ALL_DUPS HIST_REDUCE_BLANKS
setopt AUTO_CD INTERACTIVE_COMMENTS
bindkey -e

# Completion
ZPLUGINS=~/.local/share/zsh/plugins
fpath=($ZPLUGINS/zsh-completions/src $fpath)
autoload -Uz compinit && compinit
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
zstyle ':completion:*' menu select

# mise: node, pnpm and CLI tools. hook-env puts them on PATH right away for the lines below.
if command -v mise >/dev/null; then
  eval "$(mise activate zsh)"
  eval "$(mise hook-env -s zsh)"
fi

command -v starship >/dev/null && eval "$(starship init zsh)"
command -v zoxide   >/dev/null && eval "$(zoxide init zsh)"
command -v fzf      >/dev/null && source <(fzf --zsh)

# Aliases
alias g=git
alias lg=lazygit
if command -v eza >/dev/null; then
  alias ls='eza --group-directories-first'
  alias ll='eza -la --git --group-directories-first'
  alias tree='eza --tree --git-ignore'
fi
alias ni='pnpm install'
alias nr='pnpm run'
alias dev='pnpm run dev'

[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local

# Plugins (syntax-highlighting must be last)
[[ -f $ZPLUGINS/zsh-autosuggestions/zsh-autosuggestions.zsh ]] && source $ZPLUGINS/zsh-autosuggestions/zsh-autosuggestions.zsh
[[ -f $ZPLUGINS/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]] && source $ZPLUGINS/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
